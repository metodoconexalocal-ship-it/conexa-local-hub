# Google OAuth Credentials
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui
# Redirect URI registrada no Google Cloud (automática: <base>/api/auth/google/callback)
# Base pública do app (opcional). Local: http://localhost:3000 | Produção: https://conexa-local-hub.vercel.app
# PUBLIC_BASE_URL=http://localhost:3000

# Chave para cifrar o cookie de sessão Google (opcional; se vazia usa GOOGLE_CLIENT_SECRET)
# SESSION_SECRET=gere-uma-string-aleatoria-longa

# Firebase Configuration (opcional)
# FIREBASE_PROJECT_ID=seu-projeto-firebase
# FIREBASE_PRIVATE_KEY_ID=abc123...
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@seu-projeto.iam.gserviceaccount.com
# FIREBASE_CLIENT_ID=123456789
# FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
# FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...

# Application
NODE_ENV=development
PORT=3000

# Firebase Admin (Firestore): cole o JSON inteiro da conta de serviço em uma linha
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
